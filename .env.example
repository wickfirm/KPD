# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
#
# DATABASE_URL  = the POOLED connection (Transaction pooler, port 6543).
#                 Used by the app at runtime (serverless-friendly).
# DIRECT_URL    = the DIRECT connection (port 5432).
#                 Used only by `prisma db:push` / `migrate`.
#
# Replace [YOUR-PASSWORD] and copy region/host parts from your Supabase panel.
DATABASE_URL="postgresql://postgres.kpd-project:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.kpd-project:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"


# ── CMS Admin bootstrap (used only when the users table is empty) ────────────
ADMIN_EMAIL="admin@kpd.ae"
ADMIN_PASSWORD="change-me-immediately"
ADMIN_NAME="KPD Admin"

# ── Session signing secret (generate: openssl rand -base64 32) ──────────────
AUTH_SECRET="replace-with-a-long-random-string"

# ── RSS ingest cron (vercel.json runs /api/cron/rss-ingest every 30 min) ─────
# Requests must send: Authorization: Bearer <CRON_SECRET>
# Vercel cron invocations set this automatically from this env var.
CRON_SECRET="replace-with-a-long-random-string"


# ── Salesforce dual-write integration (provided by client) ──────────────────
SALESFORCE_LOGIN_URL="https://login.salesforce.com"
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_USERNAME=""
SALESFORCE_PASSWORD=""
SALESFORCE_SECURITY_TOKEN=""

# ── Cloudflare R2 (S3-compatible asset storage, served via Cloudflare CDN) ───
# R2 dashboard → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=""                # Cloudflare dashboard → R2 → account id (also in the S3 API URL)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="kpd-assets"
# Public delivery URL: either your custom domain bound to the bucket
# (recommended, e.g. https://assets.kpd.ae) or the bucket's r2.dev URL
R2_PUBLIC_BASE_URL="https://assets.kpd.ae"
