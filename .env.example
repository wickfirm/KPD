# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
#
# DATABASE_URL  = the POOLED connection (Transaction pooler, port 6543).
#                 Used by the app at runtime (serverless-friendly).
# DIRECT_URL    = the DIRECT connection (port 5432).
#                 Used only by `prisma db:push` / `migrate`.
#
# Replace [YOUR-PASSWORD] and copy region/host parts from your Supabase panel.
DATABASE_URL="postgresql://postgres.kpd-project:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.kpd-project:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"


# ── CMS Admin bootstrap (used only when the users table is empty) ────────────
ADMIN_EMAIL="admin@kpd.ae"
ADMIN_PASSWORD="change-me-immediately"
ADMIN_NAME="KPD Admin"

# ── Session signing secret (generate: openssl rand -base64 32) ──────────────
AUTH_SECRET="replace-with-a-long-random-string"

# ── RSS ingest cron (vercel.json runs /api/cron/rss-ingest every 30 min) ─────
# Requests must send: Authorization: Bearer <CRON_SECRET>
# Vercel cron invocations set this automatically from this env var.
CRON_SECRET="replace-with-a-long-random-string"


# ── Salesforce dual-write integration (provided by client) ──────────────────
# Production is the default: only the client id and secret are required.
# Client credentials flow; leave the username and password empty.
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
# Optional overrides. Leave EMPTY in production (the code defaults to the
# production My Domain, org 00Dam00001apx41EAA, Website Leads queue
# 00GWj00000HI934MAD and placeholder Project a09Wj00000IMtBbIAL).
# For the UAT sandbox set all four to the sandbox values.
SALESFORCE_LOGIN_URL=""
SALESFORCE_ORG_ID=""
SALESFORCE_LEAD_OWNER_ID=""
SALESFORCE_PROJECT_PLACEHOLDER_ID=""
# Optional JSON: development name -> final Salesforce Project record id, e.g.
# {"seven x seven":"a09...","Villa 174":"a09..."}. Developments not listed use the placeholder.
SALESFORCE_PROJECT_RECORD_IDS=""
SALESFORCE_USERNAME=""
SALESFORCE_PASSWORD=""
SALESFORCE_SECURITY_TOKEN=""

# ── Brochure email (visitor download link) ───────────────────────────────────
# Required before a brochure request can email the file. The lead is still saved
# in Enquiries when these are empty.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Kasumigaseki Properties Development <info@kpd.ae>"
EMAIL_REPLY_TO=""

# ── Form notifications (Resend) ──────────────────────────────────────────────
# Every form submission is saved in the CMS; with these set, the team is also
# emailed a copy at the recipient chosen in Site settings → Form delivery
# routing, and brochure requests email the visitor through Resend (SMTP above is
# then not needed). RESEND_FROM must use a domain verified in Resend; leave it
# empty to use Resend's default sender onboarding@resend.dev, which only
# delivers to the Resend account owner's address.
RESEND_API_KEY=""
RESEND_FROM=""

# ── Cloudflare R2 (S3-compatible asset storage, served via Cloudflare CDN) ───
# R2 dashboard → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=""                # Cloudflare dashboard → R2 → account id (also in the S3 API URL)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="kpd-assets"
# Public delivery URL: either your custom domain bound to the bucket
# (recommended, e.g. https://assets.kpd.ae) or the bucket's r2.dev URL
R2_PUBLIC_BASE_URL="https://assets.kpd.ae"

# Canonical public origin used by metadataBase, sitemap.xml and robots.txt.
# The Vercel project is pinned to the sin1 region to match Supabase Singapore.
NEXT_PUBLIC_SITE_URL="https://kpd.ae"

# Pre-launch gate: while BOTH are set, the public site asks for this username
# and password (admin, /api, assets and Google verification files stay open).
# Clear either one, or set SITE_GATE=off, and redeploy to open the site.
SITE_GATE_USER=
SITE_GATE_PASSWORD=
# SITE_GATE=off

# ── Article "Generate with AI" (Anthropic / Claude) ─────────────────────────
# Powers the Generate with AI buttons under an article's Title, Summary and
# Cover image alt text. Without a key the buttons say AI is not set up.
# Key: console.anthropic.com
ANTHROPIC_API_KEY=""
# Optional: model used. Default claude-haiku-5-5.
ARTICLE_AI_MODEL=""
